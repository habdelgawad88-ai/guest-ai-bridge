{
  "name": "guest-ai-bridge",
  "version": "0.7.0",
  "description": "Autonomous no-login/no-key free AI provider discovery, selection and MCP chat bridge",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "guest-ai-bridge": "./src/cli.cjs",
    "guest-ai-bridge-mcp": "./src/mcp.cjs",
    "guest-ai-bridge-personal": "./src/mcp-personal.cjs"
  },
  "scripts": {
    "mcp": "node src/mcp.cjs",
    "install:claude": "node setup-claude.cjs",
    "test": "node --test test/*.test.cjs",
    "catalog": "node src/cli.cjs providers",
    "models": "node src/cli.cjs models",
    "selected": "node src/cli.cjs selected",
    "plan": "node src/cli.cjs plan",
    "auto": "node src/cli.cjs auto",
    "discover": "node src/cli.cjs discover",
    "auto-add": "node src/cli.cjs auto-add",
    "refresh": "node src/cli.cjs refresh",
    "proxy": "node src/proxy.cjs",
    "install:agents": "node setup-agents.cjs",
    "install:codex": "node setup-agents.cjs codex",
    "install:hermes": "node setup-agents.cjs hermes",
    "install:pi": "node setup-agents.cjs pi",
    "install:antigravity": "node setup-agents.cjs antigravity"
  }
}
